from reportlab.lib.pagesizes import letter, A4
from reportlab.lib.units import inch
from reportlab.pdfgen import canvas
from reportlab.lib import colors
from datetime import datetime
import io

def generate_invoice_pdf(payment, vendor):
    '''Generate PDF invoice for payment'''
    
    buffer = io.BytesIO()
    c = canvas.Canvas(buffer, pagesize=A4)
    width, height = A4
    
    # Header
    c.setFont("Helvetica-Bold", 24)
    c.drawString(50, height - 50, "INVOICE")
    
    # Invoice details
    c.setFont("Helvetica", 10)
    y = height - 100
    
    c.drawString(50, y, f"Invoice Number: {payment.invoice_number}")
    y -= 20
    c.drawString(50, y, f"Date: {payment.completed_at.strftime('%d %B %Y')}")
    y -= 20
    c.drawString(50, y, f"Payment ID: {payment.payment_id}")
    
    # Vendor details
    y -= 40
    c.setFont("Helvetica-Bold", 12)
    c.drawString(50, y, "Bill To:")
    c.setFont("Helvetica", 10)
    y -= 20
    c.drawString(50, y, vendor.company_name)
    y -= 15
    c.drawString(50, y, vendor.owner_name)
    y -= 15
    c.drawString(50, y, f"Vendor ID: {vendor.vendor_id}")
    y -= 15
    c.drawString(50, y, vendor.email)
    y -= 15
    c.drawString(50, y, vendor.mobile)
    
    # Line items table
    y -= 40
    c.setFont("Helvetica-Bold", 10)
    c.drawString(50, y, "Description")
    c.drawString(300, y, "Quantity")
    c.drawString(400, y, "Price")
    c.drawString(500, y, "Amount")
    
    y -= 5
    c.line(50, y, width - 50, y)
    
    y -= 20
    c.setFont("Helvetica", 10)
    c.drawString(50, y, "Lead Credits")
    c.drawString(300, y, str(payment.credits_purchased))
    c.drawString(400, y, f"₹{payment.amount / payment.credits_purchased:.2f}")
    c.drawString(500, y, f"₹{payment.amount:.2f}")
    
    # Total
    y -= 30
    c.line(400, y, width - 50, y)
    y -= 20
    c.setFont("Helvetica-Bold", 12)
    c.drawString(400, y, "Total:")
    c.drawString(500, y, f"₹{payment.amount:.2f}")
    
