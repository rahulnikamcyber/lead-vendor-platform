# sample_data_generator.py - Generate Test Data
# ============================================
# Save as: sample_data_generator.py (root directory)

import requests
import random
from datetime import datetime

BASE_URL = "http://localhost:8000"

# Sample data
CITIES = ["Surat", "Ahmedabad", "Vadodara", "Rajkot", "Mumbai", "Delhi", "Pune"]
SERVICES = ["Solar", "Electrical", "Plumbing", "Construction", "Renovation", "Painting"]
NAMES = ["Amit Patel", "Priya Shah", "Rahul Kumar", "Sneha Desai", "Vijay Mehta", 
         "Pooja Singh", "Karan Joshi", "Neha Sharma"]
BUDGET_RANGES = ["Under 50k", "50k-1L", "1L-2L", "2L-5L", "Above 5L"]

def generate_leads(count=10):
    """Generate sample leads"""
    print(f"\n🔄 Generating {count} sample leads...")
    
    for i in range(count):
        lead_data = {
            "full_name": random.choice(NAMES),
            "mobile": f"98765{random.randint(10000, 99999)}",
            "city": random.choice(CITIES),
            "service_type": random.choice(SERVICES),
            "budget_range": random.choice(BUDGET_RANGES),
            "notes": f"Sample lead #{i+1}"
        }
        
        try:
            response = requests.post(f"{BASE_URL}/api/leads/", json=lead_data)
            if response.status_code == 200:
                result = response.json()
                print(f"✅ Lead created: {result['lead_id']}")
            else:
                print(f"❌ Error creating lead: {response.text}")
        except Exception as e:
            print(f"❌ Exception: {e}")

def generate_vendors(count=5):
    """Generate sample vendors"""
    print(f"\n🔄 Generating {count} sample vendors...")
    
    for i in range(count):
        city = random.choice(CITIES)
        service = random.choice(SERVICES)
        
        vendor_data = {
            "company_name": f"{service} Solutions {city}",
            "owner_name": random.choice(NAMES),
            "mobile": f"98765{random.randint(10000, 99999)}",
            "email": f"vendor{i+1}@example.com",
            "city": city,
            "service_type": service,
            "password": "Vendor@123"
        }
        
        try:
            response = requests.post(f"{BASE_URL}/api/vendors/register", json=vendor_data)
            if response.status_code == 200:
                result = response.json()
                print(f"✅ Vendor created: {result['vendor_id']} - {result['company_name']}")
            else:
                print(f"❌ Error creating vendor: {response.text}")
        except Exception as e:
            print(f"❌ Exception: {e}")

def activate_vendors():
    """Activate vendors by adding credits (Admin only)"""
    print(f"\n🔄 Activating vendors (adding credits)...")
    
    # Login as admin
    login_data = {"username": "admin@example.com", "password": "Admin@123"}
    login_response = requests.post(f"{BASE_URL}/api/auth/login", data=login_data)
    
    if login_response.status_code != 200:
        print("❌ Failed to login as admin")
        return
    
    token = login_response.json()["access_token"]
    headers = {"Authorization": f"Bearer {token}"}
    
    # Get all vendors
    vendors_response = requests.get(f"{BASE_URL}/api/admin/vendors", headers=headers)
    vendors = vendors_response.json()["vendors"]
    
    for vendor in vendors:
        # Add 10 credits to each vendor
        credits_data = {"credits": 10}
        update_response = requests.put(
            f"{BASE_URL}/api/admin/vendors/{vendor['id']}/credits",
            headers=headers,
            params={"credits": 10}
        )
        
        if update_response.status_code == 200:
            print(f"✅ Added credits to {vendor['vendor_id']}")
        else:
            print(f"❌ Failed to add credits to {vendor['vendor_id']}")

if __name__ == "__main__":
    print("=" * 60)
    print("🎲 Lead-Vendor Platform - Sample Data Generator")
    print("=" * 60)
    print("⚠️  Make sure the application is running on http://localhost:8000")
    print()
    
    choice = input("Choose option:\n1. Generate Vendors\n2. Generate Leads\n3. Generate Both\n4. Activate All Vendors\n\nEnter (1-4): ")
    
    if choice == "1":
        count = int(input("How many vendors? (default 5): ") or 5)
        generate_vendors(count)
    elif choice == "2":
        count = int(input("How many leads? (default 10): ") or 10)
        generate_leads(count)
    elif choice == "3":
        vendor_count = int(input("How many vendors? (default 5): ") or 5)
        lead_count = int(input("How many leads? (default 10): ") or 10)
        generate_vendors(vendor_count)
        print("\n⏳ Waiting 2 seconds before generating leads...")
        import time
        time.sleep(2)
        activate_vendors()
        print("\n⏳ Waiting 2 seconds before generating leads...")
        time.sleep(2)
        generate_leads(lead_count)
    elif choice == "4":
        activate_vendors()
    else:
        print("Invalid choice")
    
    print("\n✅ Done!")


